# Required for: npx prisma migrate dev, npm run seed
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deal_driver?schema=public"

# Optional — only if/when NextAuth routes are wired up
NEXTAUTH_URL="http://127.0.0.1:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional — Vehicle Databases media API (requires x-authkey header; not usable on <img src> directly)
# VEHICLE_DATABASES_API_KEY="your-api-key"
